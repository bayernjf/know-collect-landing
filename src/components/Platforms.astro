---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const platforms =
  lang === 'zh'
    ? [
        { name: '抖音', icon: '🎵', desc: '支持 v.douyin.com 短链与完整链接，自动抓取视频封面与作者。' },
        { name: 'B站', icon: '📺', desc: '支持 bilibili.com 视频链接，提取 BV 号与 UP 主信息。' },
        { name: '小红书', icon: '📕', desc: '支持 xhslink.com 分享链接与完整链接，抓取笔记标题与封面。' },
      ]
    : [
        { name: 'Douyin', icon: '🎵', desc: 'Supports v.douyin.com short links and full URLs. Auto-fetches covers and authors.' },
        { name: 'Bilibili', icon: '📺', desc: 'Supports bilibili.com video URLs. Extracts BV IDs and uploader info.' },
        { name: 'Xiaohongshu', icon: '📕', desc: 'Supports xhslink.com share links and full URLs. Fetches note titles and covers.' },
      ];
---

<section id="platforms" class="border-t border-ink-800/60 bg-ink-950 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-ink-50 sm:text-4xl">{t('platforms.title')}</h2>
      <p class="mt-3 text-ink-400">{t('platforms.subtitle')}</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3">
      {platforms.map((p) => (
        <div class="rounded-xl border border-ink-800 bg-ink-900/60 p-8 text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-ink-800 text-3xl">
            {p.icon}
          </div>
          <h3 class="mt-4 text-lg font-semibold text-ink-50">{p.name}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-400">{p.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
