---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const isZh = lang === 'zh';

const rows = isZh
  ? [
      { dim: '跨平台收藏', vv: '抖音/B站/小红书', browser: '仅存链接', notion: '手动粘贴', native: '各平台独立' },
      { dim: '自动抓取元数据', vv: '标题/作者/封面', browser: '无', notion: '手动', native: '部分' },
      { dim: 'AI 视频总结', vv: '一键生成', browser: '无', notion: '需自行调用', native: '无' },
      { dim: '文件夹分组', vv: '支持', browser: '文件夹', notion: '支持', native: '收藏夹' },
      { dim: '笔记批注', vv: '支持', browser: '无', notion: '支持', native: '有限' },
      { dim: '报告导出', vv: '支持', browser: '无', notion: '手动', native: '无' },
      { dim: '数据归属', vv: '本地优先，归用户', browser: '浏览器', notion: 'Notion 云', native: '平台云' },
      { dim: '离线可用', vv: '是', browser: '是', notion: '否', native: '否' },
    ]
  : [
      { dim: 'Cross-platform', vv: 'Douyin/Bilibili/Xiaohongshu', browser: 'Links only', notion: 'Manual paste', native: 'Per-platform' },
      { dim: 'Auto metadata', vv: 'Title/author/cover', browser: 'None', notion: 'Manual', native: 'Partial' },
      { dim: 'AI summaries', vv: 'One-click', browser: 'None', notion: 'DIY', native: 'None' },
      { dim: 'Folders', vv: 'Yes', browser: 'Bookmarks', notion: 'Yes', native: 'Favorites' },
      { dim: 'Notes', vv: 'Yes', browser: 'None', notion: 'Yes', native: 'Limited' },
      { dim: 'Report export', vv: 'Yes', browser: 'None', notion: 'Manual', native: 'None' },
      { dim: 'Data ownership', vv: 'Local-first, yours', browser: 'Browser', notion: 'Notion cloud', native: 'Platform cloud' },
      { dim: 'Offline', vv: 'Yes', browser: 'Yes', notion: 'No', native: 'No' },
    ];

const cols = isZh
  ? [
      { key: 'dim', label: '维度' },
      { key: 'vv', label: 'VideoVault' },
      { key: 'browser', label: '浏览器收藏夹' },
      { key: 'notion', label: 'Notion 手记' },
      { key: 'native', label: '平台自带收藏' },
    ]
  : [
      { key: 'dim', label: 'Dimension' },
      { key: 'vv', label: 'VideoVault' },
      { key: 'browser', label: 'Browser bookmarks' },
      { key: 'notion', label: 'Notion notes' },
      { key: 'native', label: 'Platform favorites' },
    ];
---

<section id="comparison" class="border-t border-ink-800/60 bg-ink-950 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-ink-50 sm:text-4xl">{t('compare.title')}</h2>
      <p class="mt-3 text-ink-400">{t('compare.subtitle')}</p>
    </div>

    <div class="mt-12 overflow-x-auto">
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr class="border-b border-ink-800">
            {cols.map((c, i) => (
              <th class={`px-4 py-3 text-left font-medium ${i === 1 ? 'text-brand-300' : 'text-ink-400'}`}>
                {c.label}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-b border-ink-800/50">
              {cols.map((c, i) => (
                <td class={`px-4 py-3 ${i === 0 ? 'text-ink-300' : ''} ${i === 1 ? 'font-medium text-brand-200' : 'text-ink-400'}`}>
                  {(row as any)[c.key]}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
