---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { localizePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
}

const { lang, title, description, pubDate, tags } = Astro.props;
const dateStr = pubDate.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const backHref = localizePath('/blog', lang);
---

<BaseLayout title={title} description={description} lang={lang}>
  <Nav lang={lang} />
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <a href={backHref} class="text-sm text-ink-500 transition hover:text-ink-200">
      ← {lang === 'zh' ? '返回博客' : 'Back to blog'}
    </a>
    <h1 class="mt-6 text-3xl font-bold text-ink-50 sm:text-4xl">{title}</h1>
    <div class="mt-3 flex flex-wrap items-center gap-3 text-xs text-ink-500">
      <time datetime={pubDate.toISOString()}>{dateStr}</time>
      {tags && tags.length > 0 && (
        <span class="flex gap-1">
          {tags.map((tag) => (
            <span class="rounded bg-ink-800 px-1.5 py-0.5 font-mono text-ink-400">#{tag}</span>
          ))}
        </span>
      )}
    </div>
    <div class="prose mt-8">
      <slot />
    </div>
  </article>
  <Footer lang={lang} />
</BaseLayout>
